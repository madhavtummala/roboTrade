# Copy to .env for local Docker Compose, or provide these as host/container
# environment variables in production. Do not commit real secrets.

ALPACA_API_KEY=replace_me
ALPACA_API_SECRET=replace_me
ALPACA_BASE_URL=https://paper-api.alpaca.markets
ALPACA_DATA_FEED=iex
KILL_SWITCH=false

# Optional Alpha Vantage support for generating app-managed news/social data.
ALPHA_VANTAGE_API_KEY=

# Container paths. Keep these as-is for the provided Docker/Compose setup.
TRADING_CONFIG_FILE=/config/trading_bot.yaml
STATE_DB_PATH=/data/trading_bot.sqlite
LOG_FILE=/logs/trading.log
